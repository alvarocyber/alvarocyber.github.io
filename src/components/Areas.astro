---
import SectionHeading from './SectionHeading.astro';
import { copy } from '../i18n';
const { areas } = copy;

const levelStyles: Record<string, string> = {
	uso: 'border-accent/40 text-ink',
	aprendiendo: 'border-white/20 text-ink',
	explorando: 'border-white/10 text-muted',
};
const dotStyles: Record<string, string> = {
	uso: 'bg-accent',
	aprendiendo: 'bg-ink',
	explorando: 'bg-muted',
};
---

<section id="areas" class="px-4 py-24 md:py-32">
	<div class="mx-auto max-w-6xl">
		<SectionHeading number={areas.number} title={areas.title} intro={areas.intro} />

		<ul data-reveal class="mb-12 flex flex-wrap gap-6">
			{
				(['uso', 'aprendiendo', 'explorando'] as const).map((level) => (
					<li class="flex items-center gap-2 text-sm text-muted">
						<span class={`inline-block h-2 w-2 rounded-full ${dotStyles[level]}`}></span>
						{areas.levels[level]}
					</li>
				))
			}
		</ul>

		<div class="grid gap-px overflow-hidden rounded-2xl border border-white/10 bg-white/5 md:grid-cols-2">
			{
				areas.groups.map((group, i) => (
					<article
						data-reveal
						class="flex flex-col gap-6 bg-ground p-6 md:p-8"
						style={`transition-delay:${i * 80}ms`}
					>
						<header class="flex items-baseline gap-4">
							<span class="font-mono text-xs font-semibold text-accent">{group.index}</span>
							<h3 class="font-display text-xl font-semibold text-ink">{group.title}</h3>
						</header>
						<ul class="flex flex-wrap gap-2">
							{group.items.map((item) => (
								<li
									class={`flex items-center gap-2 rounded-full border px-3 py-2 text-sm ${levelStyles[item.level]}`}
								>
									<span class={`inline-block h-1.5 w-1.5 rounded-full ${dotStyles[item.level]}`}></span>
									{item.name}
								</li>
							))}
						</ul>
					</article>
				))
			}
		</div>
	</div>
</section>
