---
import { copy } from '../i18n';
const { hero, socials } = copy;
const socialList = [socials.github, socials.linkedin, socials.email];
const isPending = (href: string) => href.startsWith('[');
---

<section id="inicio" class="relative overflow-hidden px-4 pb-24 pt-40 md:pb-32 md:pt-48">
	<div class="pointer-events-none absolute inset-0 -z-10 opacity-[0.35]" aria-hidden="true">
		<svg class="h-full w-full" xmlns="http://www.w3.org/2000/svg">
			<defs>
				<pattern id="grid" width="64" height="64" patternUnits="userSpaceOnUse">
					<path d="M64 0 H0 V64" fill="none" stroke="#272727" stroke-width="1" />
				</pattern>
			</defs>
			<rect width="100%" height="100%" fill="url(#grid)" />
		</svg>
	</div>

	<div class="mx-auto grid max-w-6xl items-center gap-16 lg:grid-cols-[1.15fr_0.85fr]">
		<div>
			<p data-hero class="mb-6 font-mono text-xs font-semibold uppercase tracking-[0.2em] text-accent" style="animation-delay:0ms">
				{hero.eyebrow}
			</p>

			<h1 class="max-w-[680px] font-display text-5xl font-semibold leading-none tracking-tight md:text-6xl lg:text-7xl">
				<span data-hero class="block bg-gradient-to-r from-ink to-[#9b9b9b] bg-clip-text text-transparent" style="animation-delay:100ms">
					{hero.title[0]}
				</span>
				<span data-hero class="block bg-gradient-to-r from-ink to-[#9b9b9b] bg-clip-text text-transparent" style="animation-delay:220ms">
					{hero.title[1]}
				</span>
			</h1>

			<p data-hero class="mt-8 max-w-[680px] text-lg leading-7 text-muted" style="animation-delay:340ms">
				{hero.subtitle}
			</p>

			<div data-hero class="mt-10 flex flex-wrap items-center gap-3" style="animation-delay:460ms">
				<a href={hero.primaryCta.href} class="btn-primary">
					{hero.primaryCta.label}
					<svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
						<path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
					</svg>
				</a>
				<a href={hero.secondaryCta.href} class="btn-ghost">
					{hero.secondaryCta.label}
				</a>
			</div>

			<ul data-hero class="mt-10 flex flex-col gap-2 text-sm text-muted" style="animation-delay:580ms">
				{hero.facts.map((fact) => (
					<li class="flex items-center gap-2">
						<span class="h-1 w-1 rounded-full bg-accent"></span>
						{fact}
					</li>
				))}
			</ul>

			<ul data-hero class="mt-8 flex flex-wrap items-center gap-4" style="animation-delay:700ms">
				{socialList.map((s) => (
					<li>
						{isPending(s.href) ? (
							<span class="text-sm text-muted/60" title="Enlace pendiente de configurar" aria-disabled="true">
								{s.label} · pendiente
							</span>
						) : (
							<a href={s.href} class="text-sm font-semibold text-muted transition-colors duration-700 ease-fluid hover:text-accent">
								{s.label}
							</a>
						)}
					</li>
				))}
			</ul>
		</div>

		<div data-hero class="relative" style="animation-delay:300ms">
			<svg data-diagram viewBox="0 0 400 400" class="h-auto w-full max-w-md" role="img" aria-label="Diagrama de nodos y conexiones">
				<g fill="none" stroke="#313131" stroke-width="1.5">
					<path d="M80 300 L200 100 L320 300" />
					<path d="M80 300 L320 300" />
					<path d="M200 100 L200 300" />
					<path d="M80 300 L200 300" />
					<path d="M140 200 L260 200" />
					<path d="M200 100 L80 300 M200 100 L320 300" />
				</g>
				<g stroke="#d97745" stroke-width="1.5" opacity="0.5">
					<circle cx="200" cy="100" r="46" fill="none" />
					<circle cx="200" cy="100" r="72" fill="none" />
				</g>
				<g>
					<circle cx="200" cy="100" r="8" fill="#d97745" />
					<circle cx="80" cy="300" r="6" fill="#f2f0ea" />
					<circle cx="320" cy="300" r="6" fill="#f2f0ea" />
					<circle cx="140" cy="200" r="5" fill="#a4a4a4" />
					<circle cx="260" cy="200" r="5" fill="#a4a4a4" />
					<circle cx="200" cy="300" r="5" fill="#a4a4a4" />
				</g>
			</svg>
		</div>
	</div>
</section>

<style>
	[data-hero] {
		opacity: 0;
		animation: heroIn 900ms cubic-bezier(0.32, 0.72, 0, 1) forwards;
	}

	@keyframes heroIn {
		from {
			opacity: 0;
			transform: translateY(1.5rem);
			filter: blur(8px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
			filter: blur(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		[data-hero] {
			opacity: 1;
			animation: none;
		}
	}
</style>
