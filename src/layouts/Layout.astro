---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { copy } from '../i18n';

interface Props {
	title?: string;
	description?: string;
	ogImage?: string;
}

const {
	title = copy.meta.title,
	description = copy.meta.description,
	ogImage = copy.meta.ogImage,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const ogUrl = new URL(ogImage, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang={copy.htmlLang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={canonical} />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#101010" />

		<title>{title}</title>
		<meta name="description" content={description} />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogUrl} />
		<meta property="og:locale" content="es_ES" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogUrl} />

		<noscript>
			<style>
				[data-reveal] {
					opacity: 1 !important;
					transform: none !important;
					filter: none !important;
				}
			</style>
		</noscript>
	</head>
	<body>
		<a
			href="#contenido"
			class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-accent focus:px-3 focus:py-2 focus:text-base focus:font-semibold focus:text-ground"
		>
			Saltar al contenido
		</a>
		<Nav />
		<main id="contenido">
			<slot />
		</main>
		<Footer />
	</body>
</html>
