---
import { stops } from '../data/stops';
---

<nav
	data-route-rail
	aria-label="Recorrido del portfolio"
	class="pointer-events-none fixed right-4 top-1/2 z-30 hidden -translate-y-1/2 xl:block"
>
	<ol class="pointer-events-auto flex flex-col items-end gap-4">
		{
			stops.map((stop) => (
				<li class="group flex items-center justify-end">
					<a
						href={`#${stop.id}`}
						data-rail-link={stop.id}
						aria-label={`Ir a ${stop.label}`}
						class="flex items-center justify-end gap-3 rounded-full py-1"
					>
						<span class="rail-label translate-x-2 whitespace-nowrap rounded-full border border-white/10 bg-surface/80 px-3 py-1 text-xs font-semibold text-muted opacity-0 backdrop-blur transition-all duration-500 ease-fluid group-hover:translate-x-0 group-hover:text-ink group-hover:opacity-100 group-focus-within:translate-x-0 group-focus-within:opacity-100">
							{stop.label}
						</span>
						<span class="rail-tick block h-2.5 w-2.5 rounded-full border border-white/25 transition-all duration-500 ease-fluid group-hover:border-accent" />
					</a>
				</li>
			))
		}
	</ol>
</nav>

<style>
	[data-rail-link].is-active .rail-tick {
		border-color: var(--color-accent);
		background-color: var(--color-accent);
		transform: scale(1.4);
	}

	@media (prefers-reduced-motion: reduce) {
		.rail-tick,
		[data-rail-link].is-active .rail-tick {
			transition: none;
		}
	}
</style>

<script>
	import { initScrollState, onActiveSection } from '../scripts/scroll-state';

	initScrollState();
	const links = [...document.querySelectorAll<HTMLElement>('[data-rail-link]')];

	onActiveSection((id) => {
		links.forEach((link) => {
			const active = link.dataset.railLink === id;
			link.classList.toggle('is-active', active);
			if (active) link.setAttribute('aria-current', 'true');
			else link.removeAttribute('aria-current');
		});
	});
</script>