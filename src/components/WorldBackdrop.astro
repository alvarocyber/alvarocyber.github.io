---
import { stops } from '../data/stops';

const positions: Record<string, { x: number; y: number }> = {
	inicio: { x: 150, y: 660 },
	'sobre-mi': { x: 310, y: 520 },
	areas: { x: 460, y: 620 },
	proyectos: { x: 620, y: 420 },
	proceso: { x: 780, y: 550 },
	formacion: { x: 920, y: 370 },
	contacto: { x: 1080, y: 300 },
};

const nodes = stops.map((stop) => ({ id: stop.id, ...positions[stop.id] }));

const satellites = [
	{ x: 220, y: 740 },
	{ x: 390, y: 380 },
	{ x: 560, y: 500 },
	{ x: 700, y: 680 },
	{ x: 860, y: 500 },
	{ x: 1000, y: 520 },
	{ x: 160, y: 440 },
	{ x: 650, y: 240 },
	{ x: 990, y: 250 },
];

type Edge = { x1: number; y1: number; x2: number; y2: number; stops: string[] };

const edges: Edge[] = [];
for (let i = 1; i < nodes.length; i++) {
	const a = nodes[i - 1];
	const b = nodes[i];
	edges.push({ x1: a.x, y1: a.y, x2: b.x, y2: b.y, stops: [a.id, b.id] });
}

const branches: [number, number][] = [
	[0, 0],
	[0, 6],
	[1, 1],
	[2, 2],
	[3, 3],
	[3, 7],
	[4, 4],
	[5, 8],
	[6, 5],
];

branches.forEach(([nodeIndex, satelliteIndex]) => {
	const node = nodes[nodeIndex];
	const satellite = satellites[satelliteIndex];
	edges.push({ x1: node.x, y1: node.y, x2: satellite.x, y2: satellite.y, stops: [node.id] });
});
---

<div
	data-world
	class="pointer-events-none fixed inset-0 -z-10 hidden overflow-hidden lg:block"
	aria-hidden="true"
>
	<svg viewBox="0 0 1200 800" preserveAspectRatio="xMidYMid slice" class="h-full w-full">
		<g class="world-edges">
			{
				edges.map((edge) => (
					<line
						x1={edge.x1}
						y1={edge.y1}
						x2={edge.x2}
						y2={edge.y2}
						data-world-edge={edge.stops.join(' ')}
					/>
				))
			}
		</g>

		<g class="world-satellites">
			{
				satellites.map((satellite) => (
					<circle cx={satellite.x} cy={satellite.y} r="3" />
				))
			}
		</g>

		<g class="world-nodes">
			{
				nodes.map((node) => (
					<g data-world-node={node.id}>
						<circle class="world-node-ring" cx={node.x} cy={node.y} r="16" />
						<circle class="world-node-core" cx={node.x} cy={node.y} r="5" />
					</g>
				))
			}
		</g>
	</svg>
</div>

<style>
	.world-edges line {
		stroke: #232323;
		stroke-width: 1;
		opacity: 0.7;
		transition:
			stroke 700ms cubic-bezier(0.32, 0.72, 0, 1),
			opacity 700ms cubic-bezier(0.32, 0.72, 0, 1);
	}

	.world-edges line.is-active {
		stroke: var(--color-accent);
		opacity: 1;
	}

	.world-satellites circle {
		fill: #262626;
	}

	.world-node-ring {
		fill: none;
		stroke: #2c2c2c;
		stroke-width: 1;
		opacity: 0.6;
		transition:
			stroke 700ms cubic-bezier(0.32, 0.72, 0, 1),
			opacity 700ms cubic-bezier(0.32, 0.72, 0, 1);
	}

	.world-node-core {
		fill: #3a3a3a;
		transition: fill 700ms cubic-bezier(0.32, 0.72, 0, 1);
	}

	[data-world-node].is-active .world-node-ring {
		stroke: var(--color-accent);
		opacity: 1;
	}

	[data-world-node].is-active .world-node-core {
		fill: var(--color-accent);
	}

	@media (prefers-reduced-motion: reduce) {
		.world-edges line,
		.world-node-ring,
		.world-node-core {
			transition: none;
		}
	}
</style>

<script>
	import { initScrollState, onActiveSection } from '../scripts/scroll-state';

	const root = document.querySelector<HTMLElement>('[data-world]');
	if (root) {
		initScrollState();
		const nodes = [...root.querySelectorAll<SVGGElement>('[data-world-node]')];
		const edges = [...root.querySelectorAll<SVGLineElement>('[data-world-edge]')];

		onActiveSection((id) => {
			nodes.forEach((node) => node.classList.toggle('is-active', node.dataset.worldNode === id));
			edges.forEach((edge) =>
				edge.classList.toggle('is-active', (edge.dataset.worldEdge ?? '').split(' ').includes(id))
			);
		});
	}
</script>