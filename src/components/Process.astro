---
import SectionHeading from './SectionHeading.astro';
import { copy } from '../i18n';
const { process } = copy;
---

<section id="proceso" class="px-4 py-24 md:py-32">
	<div class="mx-auto max-w-6xl">
		<SectionHeading number={process.number} title={process.title} intro={process.intro} />

		<ol class="relative grid gap-10 md:grid-cols-4 md:gap-6">
			<div class="pointer-events-none absolute left-0 right-0 top-3 hidden h-px bg-white/10 md:block" aria-hidden="true"></div>
			{
				process.steps.map((step, i) => (
					<li data-reveal class="relative flex flex-col gap-4" style={`transition-delay:${i * 100}ms`}>
						<span class="relative z-10 flex h-6 w-6 items-center justify-center rounded-full border border-accent/40 bg-ground">
							<span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
						</span>
						<span class="font-mono text-xs font-semibold text-muted">{step.index}</span>
						<h3 class="font-display text-lg font-semibold text-ink">{step.title}</h3>
						<p class="text-sm text-muted">{step.text}</p>
					</li>
				))
			}
		</ol>
	</div>
</section>
