---
import { copy } from '../i18n';
const { footer, nav } = copy;
const year = new Date().getFullYear();
const linkClass =
	'inline-flex min-h-11 items-center text-sm text-muted transition-colors duration-700 ease-fluid hover:text-ink md:min-h-0';
const legalClass =
	'inline-flex min-h-11 items-center text-xs text-muted/80 transition-colors duration-700 ease-fluid hover:text-ink md:min-h-0';
---

<footer class="border-t border-white/5 px-4 py-12">
	<div class="mx-auto flex max-w-6xl flex-col gap-10 md:flex-row md:items-center md:justify-between md:gap-8">
		<div class="flex flex-col gap-2">
			<a href={copy.brand.home} class="flex items-center gap-2 font-display text-sm font-semibold text-ink">
				<svg width="18" height="18" viewBox="0 0 32 32" aria-hidden="true" class="shrink-0">
					<path d="M6.5 25.5 L16 7 L25.5 25.5" fill="none" stroke="#d97745" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
				</svg>
				{copy.brand.text}<span class="text-accent">.</span>
			</a>
			<p class="text-sm text-muted">© {year} · {footer.note}</p>
		</div>

		<div class="flex flex-col gap-1 md:flex-row md:items-center md:gap-6">
			<nav aria-label="Navegación del pie">
				<ul class="flex flex-wrap gap-x-6">
					{
						nav.map((link) => (
							<li>
								<a href={link.href} class={linkClass}>
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>
			<nav aria-label="Enlaces legales">
				<ul class="flex flex-wrap gap-x-6">
					{
						footer.legal.map((link) => (
							<li>
								<a href={link.href} class={legalClass}>
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>
		</div>
	</div>
</footer>
