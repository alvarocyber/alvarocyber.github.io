---
import SectionHeading from './SectionHeading.astro';
import { copy } from '../i18n';
const { projects } = copy;

const usedCategories = projects.categories.filter(
	(c) => c === 'Todos' || projects.items.some((p) => p.categories.includes(c))
);
const isPending = (href?: string) => !href || href.startsWith('[');
---

<section id="proyectos" class="px-4 py-24 md:py-32">
	<div class="mx-auto max-w-6xl">
		<SectionHeading number={projects.number} title={projects.title} intro={projects.intro} />

		{
			projects.items.length > 0 ? (
				<>
					{usedCategories.length > 2 && (
						<div data-reveal class="mb-12 flex flex-wrap gap-2">
							{usedCategories.map((cat) => (
								<button
									type="button"
									data-filter={cat}
									class="rounded-full border border-white/10 px-3 py-2 text-sm font-semibold text-muted transition-colors duration-700 ease-fluid hover:text-ink aria-pressed:border-accent/40 aria-pressed:text-ink"
									aria-pressed={cat === 'Todos' ? 'true' : 'false'}
								>
									{cat}
								</button>
							))}
						</div>
					)}

					<div class="flex flex-col gap-24 md:gap-32">
						{projects.items.map((project, i) => (
							<article
								data-project
								data-categories={project.categories.join('|')}
								data-reveal
								class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16"
							>
								<div class={i % 2 === 1 ? 'lg:order-2' : ''}>
									<div class="flex items-center gap-3">
										<span class="font-mono text-xs font-semibold text-accent">
											{String(i + 1).padStart(2, '0')}
										</span>
										<span class="rounded-full border border-white/10 px-3 py-1 text-xs text-muted">
											{project.status}
										</span>
										<span class="flex flex-wrap gap-2">
											{project.categories.map((cat) => (
												<span class="rounded-full border border-accent/30 px-3 py-1 text-xs text-accent">
													{cat}
												</span>
											))}
										</span>
									</div>

									<h3 class="mt-6 font-display text-2xl font-semibold text-ink md:text-3xl">
										{project.name}
									</h3>
									<p class="mt-4 max-w-[680px] text-base leading-7 text-muted">{project.summary}</p>

									<dl class="mt-8 flex flex-col gap-4">
										<div>
											<dt class="text-xs font-semibold uppercase tracking-wider text-accent">Contexto</dt>
											<dd class="mt-1 text-sm text-muted">{project.context}</dd>
										</div>
										<div>
											<dt class="text-xs font-semibold uppercase tracking-wider text-accent">Mi trabajo</dt>
											<dd class="mt-1 text-sm text-muted">{project.role}</dd>
										</div>
									</dl>

									<ul class="mt-6 flex flex-wrap gap-2">
										{project.tech.map((t) => (
											<li class="rounded-full border border-white/10 px-3 py-1 text-xs text-muted">{t}</li>
										))}
									</ul>

									<ul class="mt-8 flex flex-col gap-3">
										{project.challenges.map((c) => (
											<li class="flex gap-3">
												<span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-accent"></span>
												<p class="text-sm text-muted">
													<span class="font-semibold text-ink">{c.title}.</span> {c.text}
												</p>
											</li>
										))}
									</ul>

									<div class="mt-8 flex flex-wrap items-center gap-3">
										{!isPending(project.repo) && (
											<a href={project.repo} class="btn-primary" target="_blank" rel="noopener noreferrer">
												Ver repositorio
											</a>
										)}
										{!isPending(project.demo) && (
											<a href={project.demo} class="btn-ghost" target="_blank" rel="noopener noreferrer">
												Ver demo
											</a>
										)}
										{isPending(project.repo) && isPending(project.demo) && (
											<span class="text-sm text-muted/60">Sin repositorio público.</span>
										)}
									</div>
								</div>

								<div class={i % 2 === 1 ? 'order-first lg:order-1' : 'order-first lg:order-none'}>
									{project.image ? (
										<img
											src={project.image.src}
											alt={project.image.alt}
											loading="lazy"
											decoding="async"
											class="aspect-[4/3] w-full rounded-2xl border border-white/10 object-cover"
										/>
									) : (
										<div class="flex aspect-[4/3] w-full items-center justify-center rounded-2xl border border-white/10 bg-surface">
											<span class="text-sm text-muted">Captura pendiente</span>
										</div>
									)}
								</div>
							</article>
						))}
					</div>
				</>
			) : (
				<div data-reveal class="rounded-2xl border border-white/10 bg-surface p-8 md:p-12">
					<div class="flex max-w-[680px] flex-col gap-4">
						<div class="flex items-center gap-3">
							<span class="inline-flex h-2 w-2 animate-pulse rounded-full bg-accent"></span>
							<span class="font-mono text-xs font-semibold uppercase tracking-widest text-accent">
								En preparación
							</span>
						</div>
						<p class="font-display text-xl font-medium text-ink md:text-2xl">{projects.pendingNote}</p>
						<p class="text-sm text-muted">
							Aquí aparecerán casos de estudio reales, con repositorio, tecnologías verificadas y decisiones
							técnicas.
						</p>
					</div>
				</div>
			)
		}
	</div>
</section>

<script>
	const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
	const cards = [...document.querySelectorAll<HTMLElement>('[data-project]')];

	buttons.forEach((btn) => {
		btn.addEventListener('click', () => {
			const cat = btn.dataset.filter ?? 'Todos';
			buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
			cards.forEach((card) => {
				const cats = (card.dataset.categories ?? '').split('|').filter(Boolean);
				const show = cat === 'Todos' || cats.includes(cat);
				card.classList.toggle('hidden', !show);
			});
		});
	});
</script>
